# Módulo 2 — Portal del Cliente y Reservas (Supabase)
# Copia este archivo como .env dentro de frontend-web/ y completa los valores.
# NUNCA subas claves reales a Git. Usa únicamente la clave publishable/anon;
# la service_role key NUNCA debe ir en el frontend.

# frontend-web/.env
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLISHABLE_ANON
